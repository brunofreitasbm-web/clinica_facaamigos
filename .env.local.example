NEXT_PUBLIC_SUPABASE_URL=https://vththexblpxwocbowhsv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Hq1T72bd1XYHv-iGw_CPZQ_L6P2-3KI

# Obrigatória em runtime — lib/supabase/admin.ts usa esta chave para ignorar
# RLS (débito técnico até existir login funcional). Nunca prefixar com
# NEXT_PUBLIC_: precisa ficar só no server (Vercel > Settings > Environment
# Variables) e nunca ser exposta ao client. Pegue o valor em
# supabase.com/dashboard/project/vththexblpxwocbowhsv/settings/api-keys.
SUPABASE_SERVICE_ROLE_KEY=

# Item 9 do PRD "11 incrementos" — geração do rascunho de Relatório
# Devolutivo Familiar (app/terapeuta/paciente/[patientId]/relatorio). Só
# server-side (lib/anthropic.ts); sem ela, a Server Action retorna um erro
# amigável em vez de chamar a API. Pegue em console.anthropic.com.
ANTHROPIC_API_KEY=

# ── Chatbot WhatsApp (lib/whatsapp/) ──────────────────────────────────────
# WHATSAPP_TRANSPORT=simulator (default, nenhuma chamada externa — use
# /gestor/integracoes/whatsapp/simulador) ou =twilio (produção/sandbox real).
WHATSAPP_TRANSPORT=simulator

# Credenciais Twilio. Se autenticar com API Key (SK.../secret em vez do
# Auth Token da conta), TWILIO_ACCOUNT_SID ainda precisa ser a Account SID
# real (começa com "AC") — o SDK exige isso como terceiro parâmetro mesmo
# nesse modo. TWILIO_AUTH_TOKEN é sempre necessário à parte, pois a
# validação de assinatura do webhook (validateRequest) usa o Auth Token da
# conta, não o secret da API Key.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
# Número WhatsApp remetente, formato "whatsapp:+55...".
TWILIO_WHATSAPP_FROM=
# ContentSid de um template aprovado pelo Meta, usado só pra reabrir a
# janela de 24h quando o supervisor aprova documentos fora dela (ver
# lib/whatsapp/notify.ts). Sem isso, cai num texto de fallback (que também
# só sai de fato fora da janela quando o sender já for aprovado).
TWILIO_TEMPLATE_REOPEN_SID=
# URL pública do deploy (sem barra final) — usada na validação de
# assinatura do webhook (precisa bater com a URL configurada no Twilio).
PUBLIC_BASE_URL=

# Triagem opcional de PDF (laudo/guia) e classificação de texto livre fora
# do menu — o bot NUNCA depende disso pra avançar (lib/whatsapp/llm.ts).
BOT_LLM_ENABLED=false
GEMINI_API_KEY=
