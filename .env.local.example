NEXT_PUBLIC_SUPABASE_URL=https://vththexblpxwocbowhsv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Hq1T72bd1XYHv-iGw_CPZQ_L6P2-3KI

# Obrigatória em runtime — lib/supabase/admin.ts usa esta chave para ignorar
# RLS (débito técnico até existir login funcional). Nunca prefixar com
# NEXT_PUBLIC_: precisa ficar só no server (Vercel > Settings > Environment
# Variables) e nunca ser exposta ao client. Pegue o valor em
# supabase.com/dashboard/project/vththexblpxwocbowhsv/settings/api-keys.
SUPABASE_SERVICE_ROLE_KEY=

# Item 9 do PRD "11 incrementos" — geração do rascunho de Relatório
# Devolutivo Familiar (app/terapeuta/paciente/[patientId]/relatorio). Só
# server-side (lib/anthropic.ts); sem ela, a Server Action retorna um erro
# amigável em vez de chamar a API. Pegue em console.anthropic.com.
ANTHROPIC_API_KEY=

# Twilio SMS / WhatsApp API Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Google Gemini AI Credentials
GEMINI_API_KEY=

# Segredo compartilhado entre o pg_cron do banco e as rotas de cron
# (/api/twilio/*/trigger, /api/extractions/process, /api/intake/process —
# cadastro assistido por IA) — cada rota compara o header x-cron-secret com
# este valor antes de rodar. Depois de configurar aqui, defina o MESMO valor
# no banco:
#   alter database postgres set app.settings.cron_secret = '<mesmo valor>';
#   alter database postgres set app.settings.app_url = 'https://<seu-dominio>';
CRON_SECRET=

# Acolhimento oriundo de plano de saude (bot de WhatsApp, lib/twilio-intake-bot.ts)
# ContentSid de um template aprovado na Meta (Twilio Content API) para a 1a
# mensagem ao responsavel -- obrigatorio em producao fora da janela de 24h de
# servico. Vazio = mensagem livre (funciona no sandbox de teste).
TWILIO_INTAKE_TEMPLATE_CONTENT_SID=

# URL publica usada para validar a assinatura X-Twilio-Signature do webhook
# (app/api/webhooks/twilio/route.ts) quando ela difere de req.url -- caso
# comum atras de proxy/tunel (ngrok) em desenvolvimento. Vazio = usa a URL
# da propria requisicao (producao).
TWILIO_WEBHOOK_URL=
# So em desenvolvimento local sem tunel (o Twilio nao alcanca localhost pra
# assinar de verdade): pula a validacao de assinatura do webhook.
TWILIO_SKIP_SIGNATURE_VALIDATION=
